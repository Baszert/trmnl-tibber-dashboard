{% assign chart_id = "chart-" | append_random %}
{% assign cf = trmnl.plugin_settings.custom_fields_values %}
{% assign location_name = cf.location_name | default: "Home" %}
{% assign solar_panels = cf.solar_panels | default: "true" %}


{% assign title_current_price      = cf.title_current_price      | default: "Current price" %}
{% assign title_today_consumption  = cf.title_today_consumption  | default: "Today" %}
{% assign title_today_cost         = cf.title_today_cost         | default: "Cost" %}
{% assign title_today_production   = cf.title_today_production   | default: "Sold" %}
{% assign title_today_reward       = cf.title_today_reward       | default: "Reward" %}
{% assign title_month_consumption  = cf.title_month_consumption  | default: "Total" %}
{% assign title_month_cost         = cf.title_month_cost         | default: "Total Cost" %}

{% assign firstHome  = data.viewer.homes[0] %}
{% assign priceInfo  = firstHome.currentSubscription.priceInfo %}
{% assign priceInfoToday = priceInfo.today %}
{% assign currency   = priceInfo.current.currency %}
{% assign current_price = priceInfo.current.total %}

{%- comment -%} --- PRICE ANALYSIS --- {%- endcomment -%}
{% assign price_min = 999.0 %}
{% assign price_max = 0.0 %}
{% assign price_sum = 0.0 %}
{% assign price_count = 0 %}

{% for entry in priceInfoToday %}
  {% assign p = entry.total %}
  {% if p < price_min %}{% assign price_min = p %}{% endif %}
  {% if p > price_max %}{% assign price_max = p %}{% endif %}
  {% assign price_sum = price_sum | plus: p %}
  {% assign price_count = price_count | plus: 1 %}
{% endfor %}

{% assign price_range = price_max | minus: price_min %}
{% assign range_third = price_range | times: 0.33 %}
{% assign threshold_low = price_min | plus: range_third %}
{% assign threshold_high = price_max | minus: range_third %}

{% assign price_icon = "eq" %}
{% if current_price <= threshold_low %}
  {% assign price_icon = "low" %}
{% elsif current_price >= threshold_high %}
  {% assign price_icon = "high" %}
{% endif %}
  
{% assign now_ts = "now" | date: "%s" %}
{% assign offset = trmnl.user.utc_offset %}
{% assign local_ts = now_ts | plus: offset %}

{% assign today_date    = local_ts | date: "%Y-%m-%d" %}
{% assign current_month = local_ts | date: "%Y-%m" %}

{% assign current_time = local_ts | date: "%H:%M" %}

{% assign today_consumption  = 0 %}
{% assign today_cost         = 0 %}
{% assign today_production   = 0 %}
{% assign today_reward       = 0 %}
{% assign month_consumption  = 0 %}
{% assign month_cost         = 0 %}
{% assign last_update        = "" %}
{% assign last_update_formatted = last_update | date: "%d-%m-%Y %H:%M (%z)" %}

{% for node in firstHome.todayConsumption.nodes %}
{% assign node_date = node.from | date: "%Y-%m-%d" %}
{% if node_date == today_date %}
{% assign today_consumption = today_consumption | plus: node.consumption %}
{% assign today_cost        = today_cost        | plus: node.cost %}
{% endif %}
{% endfor %}

{% for node in firstHome.todayProduction.nodes %}
{% if node.production %}
{% assign node_date = node.from | date: "%Y-%m-%d" %}
{% if node_date == today_date %}
{% assign today_production = today_production | plus: node.production %}
{% assign today_reward     = today_reward     | plus: node.profit %}
{% endif %}
{% endif %}
{% endfor %}

{% if today_production == 0 %}
{% assign solar_panels = "false" %}
{% endif %}

{% if solar_panels == "true" %}
{% assign visible_stats = "today_production,today_reward,today_consumption,today_cost,month_consumption,month_cost" | split: "," %}
{% else %}
{% assign visible_stats = "today_consumption,today_cost,month_consumption,month_cost" | split: "," %}
{% endif %}

{% for node in firstHome.monthConsumption.nodes %}
{% assign node_month = node.from | date: "%Y-%m" %}
{% if node_month == current_month %}
{% assign month_consumption = month_consumption | plus: node.consumption %}
{% assign month_cost        = month_cost        | plus: node.cost %}
{% endif %}
{% endfor %}

{% for node in firstHome.todayConsumption.nodes reversed %}
{% if node.consumption %}
{% assign last_update = node.to %}
{% break %}
{% endif %}
{% endfor %}

{% if last_update == "" %}
{% for node in firstHome.todayProduction.nodes reversed %}
{% if node.production %}
{% assign last_update = node.to %}
{% break %}
{% endif %}
{% endfor %}
{% endif %}

{% assign last_update_raw = last_update %}

{% assign year   = last_update_raw | slice: 0, 4 %}
{% assign month  = last_update_raw | slice: 5, 2 %}
{% assign day    = last_update_raw | slice: 8, 2 %}
{% assign hour   = last_update_raw | slice: 11, 2 %}
{% assign minute = last_update_raw | slice: 14, 2 %}
{% assign tz     = last_update_raw | slice: 23, 6 %}

{% assign last_update_formatted = day | append: "-" | append: month | append: "-" | append: year | append: " " | append: hour | append: ":" | append: minute | append: " (" | append: tz | append: ")" %}
{% assign last_update_formatted_short = hour | append: ":" | append: minute | append: " (" | append: tz | append: ")" %}

{% capture money_prefix %}{% if currency == 'EUR' %}€{% endif %}{% endcapture %}
{% capture money_suffix %}{% unless currency == 'EUR' %}<small class="label--small">kr</small>{% endunless %}{% endcapture %}

{% template formatMoney %}
{% assign rounded = value | round: 2 %}
{% assign parts = rounded | split: '.' %}
{{ parts[0] }},{% if parts[1].size == 1 %}{{ parts[1] }}0{% elsif parts[1] %}{{ parts[1] }}{% else %}00{% endif %}
{% endtemplate %}

{% template dataPoint %}
<div class="flex gap--medium">
  <div class="value--small mb--4 lg:mb--10">
    <i class="hgi hgi-stroke {{ icon }}"></i>
  </div>
  <div class="mt--1">
    <div class="value--xxsmall lg:value--xsmall text--gray-30">
      {{ title }}
    </div>
    <div class="value--xsmall lg:value mt--1 bold">
      {% if money_prefix %}
        {{ money_prefix }}{% render "formatMoney", value: value %}{{ money_suffix }}
      {% else %}
        {{ value | round: 2 }}
      {% endif %}
      {% if unit %}
      <span class="label--small">{{ unit }}</span>
      {% endif %}
    </div>
  </div>
</div>
{% endtemplate %}

{% template dataPointLarge %}
<div class="flex gap--medium">
  <div class="value--small">
    <i class="hgi hgi-stroke {{ icon }}"></i>
  </div>
  <div class="mt--1">
    <div class="value--xxsmall lg:value--xsmall text--gray-30">
      {{ title }}
    </div>
    <div class="value--large lg:value--xlarge mt--1 bold text-stroke text-stroke--xlarge">
      {% if money_prefix %}
        {{ money_prefix }}{% render "formatMoney", value: value %}{{ money_suffix }}
      {% else %}
        {{ value | round: 2 }}
      {% endif %}

      <span class="value--small text-stroke text-stroke--xlarge">
        {% case price_icon %}
        {% when 'eq' %}
        <i class="hgi hgi-stroke hgi-dashed-line-01"></i>
        {% when 'high' %}
        <i class="hgi hgi-stroke hgi-circle-arrow-up-right"></i>
        {% when 'low' %}
        <i class="hgi hgi-stroke hgi-circle-arrow-down-right"></i>
        {% endcase %}
      </span>
    </div>
    
    <div class="flex gap--large mt--3 text-stroke text-stroke--xlarge">
      <div class="value--xsmall flex">
        <i class="hgi hgi-stroke hgi-arrow-down-02"></i>
        {{ money_prefix }}{% render "formatMoney", value: price_min %}{{ money_suffix }}
      </div>

      <div class="value--xsmall flex">
        <i class="hgi hgi-stroke hgi-arrow-up-02"></i>
        {{ money_prefix }}{% render "formatMoney", value: price_max %}{{ money_suffix }}
      </div>
    </div>
  </div>
</div>
{% endtemplate %}
  
<style>
  /* Scoped to .tibber-plugin so these don't leak into other plugins in a mashup.
     .chartPosition sits outside the layout, so it keeps its own (unique) name. */
  .tibber-plugin .bold { font-variation-settings: "wght" 700; }
  .tibber-plugin.relative, .tibber-plugin .relative { position: relative; }
  .chartPosition { position: absolute; left: 0; }
  .tibber-plugin .time-box { position: absolute; top: 15px; left: 15px;}
  .tibber-plugin .top-icon {
    position: absolute;
    top: 15px;
    right: 15px;
  }
  .tibber-plugin.bg-gradient {
    background: linear-gradient(0deg,rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0) 100%);
  }

  .tibber-plugin.bg-gradient--early {
    background: linear-gradient(0deg,rgba(255, 255, 255, 1) 50%, rgba(255, 255, 255, 0) 100%);
  }
</style>

