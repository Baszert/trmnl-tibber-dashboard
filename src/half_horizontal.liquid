<div id="{{ chart_id }}" class="image-dither mt--5 h--full chartPosition" style="height: 70%; width: 50%;"></div>

<div class="layout tibber-plugin flex flex--col flex--between relative h--full bg-gradient">
  <div class="w--full h--full grid gap-none grid--cols-2">
    <div class="col--span-1 flex flex--end p--5 flex--left flex--col h--full">
      {% render "dataPointLarge", 
      title: title_current_price, 
      value: priceInfo.current.total, 
      icon: "hgi-chart", 
      money_prefix: money_prefix, 
      money_suffix: money_suffix, 
      price_icon: price_icon, 
      price_max: price_max, 
      price_min: price_min %}
    </div>

    <div class="w--full grid grid--cols-2 p--5"> 
      {% for stat in visible_stats %}
      {% case stat %}
      {% when "today_production" %}
      {% render "dataPoint", 
      title: title_today_production, 
      value: today_production, 
      icon: "hgi-solar-panel-03", 
      unit: "kWh" %}

      {% when "today_reward" %}
      {% render "dataPoint", 
      title: title_today_reward, 
      value: today_reward, 
      icon: "hgi-savings", 
      money_prefix: money_prefix, 
      money_suffix: money_suffix %}

      {% when "today_consumption" %}
      {% render "dataPoint", 
      title: title_today_consumption, 
      value: today_consumption, 
      icon: "hgi-electric-plugs", 
      unit: "kWh" %}

      {% when "today_cost" %}
      {% render "dataPoint", 
      title: title_today_cost, 
      value: today_cost, 
      icon: "hgi-coins-euro", 
      money_prefix: money_prefix, 
      money_suffix: money_suffix %}

      {% when "month_consumption" %}
      {% render "dataPoint", 
      title: title_month_consumption, 
      value: month_consumption, 
      icon: "hgi-energy", 
      unit: "kWh" %}

      {% when "month_cost" %}
      {% render "dataPoint", 
      title: title_month_cost, 
      value: month_cost, 
      icon: "hgi-invoice-03", 
      money_prefix: money_prefix, 
      money_suffix: money_suffix %}
      {% endcase %}
      {% endfor %}
    </div>

  </div>
</div>

<script src="https://usetrmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
<script>
  const priceData = JSON.parse(`{{ priceInfo | json }}`);
  const timezone = "{{ firstHome.timeZone }}" || "Europe/Amsterdam";

  const mapped = {
    today: priceData.today.map(v => [new Date(v.startsAt).getTime(), v.total * 100]),
    tomorrow: priceData.tomorrow.map(v => [new Date(v.startsAt).getTime(), v.total * 100])
  };

  const allPoints = [...mapped.today, ...mapped.tomorrow];

  function getCurrentPoint() {
    const now = Date.now();

    let before = null;
    let after = null;

    for (let i = 0; i < allPoints.length - 1; i++) {
      if (allPoints[i][0] <= now && allPoints[i + 1][0] >= now) {
        before = allPoints[i];
        after = allPoints[i + 1];
        break;
      }
    }

    if (!before || !after) {
      let closest = allPoints[0];
      let smallestDiff = Math.abs(closest[0] - now);

      for (const p of allPoints) {
        const diff = Math.abs(p[0] - now);
        if (diff < smallestDiff) {
          smallestDiff = diff;
          closest = p;
        }
      }
      return { x: now, y: closest[1] };
    }

    const ratio = (now - before[0]) / (after[0] - before[0]);
    const interpolatedY = before[1] + (after[1] - before[1]) * ratio;

    return { x: now, y: interpolatedY };
  }

  function renderChart() { 
    const currentPoint = getCurrentPoint();

    const minY = Math.min(...allPoints.map(p => p[1]));

    Highcharts.chart('{{ chart_id }}', {
      chart: { 
        type: 'areaspline',
        backgroundColor: '#ffffff',
        animation: false,
        spacing: [4, 4, 4, 4],
        ['mar'+'gin']: [0, 0, 0, 0],
        height: {{ trmnl.device.height | divided_by: 3 }},
        width: null
  },

  title: { text: null },
  time: { timezone },

  plotOptions: {
    series: {
      animation: false,
        enableMouseTracking: false,
        states: { hover: { enabled: false } },
      marker: { enabled: false },
      lineWidth: 3,
        ['co'+'lor']: '#A4A4A4'
    },
    areaspline: {
      fillColor: {
        linearGradient: { x1: 0, y1: 0, x2: 0, y2: 1 },
        stops: [
          [0, 'rgba(0, 0, 0, 0.3)'],
          [1, 'rgba(255, 255, 255, 0)']
        ]
      },
      lineColor: '#757575',
        lineWidth: 3,
        threshold: minY
    }
  },

  series: [
    {
      type: "areaspline",
      data: allPoints,
      name: "Price",
      zIndex: 2
    },
    {
      type: "scatter",
      data: [currentPoint],
      marker: {
        enabled: true,
        radius: 10,
        symbol: "circle",
        fillColor: "#2e2e2e",
        lineColor: "#ffffff",
        lineWidth: 3
      },
      enableMouseTracking: false,
      zIndex: 10
    }
  ],

    tooltip: { enabled: false },
  legend: { enabled: false },

  yAxis: { 
    labels: { enabled: false },
    title: { text: null },
    gridLineWidth: 0,
      startOnTick: false,
      endOnTick: false
  },

  xAxis: { 
    type: 'datetime',
      labels: { enabled: false },
    lineWidth: 0,
      tickWidth: 0,
      gridLineWidth: 0,
      minPadding: 0,
      maxPadding: 0,
      startOnTick: false,
      endOnTick: false,
      title: { text: null }
  },

  credits: { enabled: false }
  });
  }

  document.addEventListener("DOMContentLoaded", () => {
    renderChart();
  });
</script>